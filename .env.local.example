# ──────────────────────────────────────────────────────────────────────────────
# Supabase credentials
#
# Copy this file to .env.local and fill in the values below.
# .env.local is git-ignored and will never be committed.
#
# Where to find these values:
#   1. Go to https://supabase.com and open your project.
#   2. Navigate to Project Settings → API Keys.
#   3. Copy "Project ID" → VITE_SUPABASE_URL
#   4. Copy "anon public" key → VITE_SUPABASE_ANON_KEY
#      (the anon key is safe to use client-side; it is restricted by RLS policies)
# ──────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Password gate (optional)
#
# To protect the app with a password, set VITE_APP_PASSWORD_HASH to the
# SHA-256 hash of your chosen password.
#
# Generate the hash in your browser console or Node.js:
#
#   Node.js:
#     node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"
#
#   Browser console:
#     const h=await crypto.subtle.digest('SHA-256',new TextEncoder().encode('yourpassword'));
#     console.log(Array.from(new Uint8Array(h)).map(b=>b.toString(16).padStart(2,'0')).join(''))
#
# Set this variable in the Netlify dashboard under Site → Environment variables.
# Leave it empty (or unset) to disable the password gate entirely.
# ──────────────────────────────────────────────────────────────────────────────
# VITE_APP_PASSWORD_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

