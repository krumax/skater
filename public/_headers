# HTML immer frisch laden
/*
  Cache-Control: public, max-age=0, must-revalidate

# Landing-CSS & JS (kein Hash im Dateinamen → nie lang cachen)
/landing/css/*
  Cache-Control: public, max-age=0, must-revalidate

/landing/js/*
  Cache-Control: public, max-age=0, must-revalidate

# JS & CSS (versioniert → lange cachen)
*.js
  Cache-Control: public, max-age=31536000, immutable

*.css
  Cache-Control: public, max-age=31536000, immutable

# Bilder (nicht versioniert → moderat cachen)
*.png
  Cache-Control: public, max-age=86400

*.jpg
  Cache-Control: public, max-age=86400

*.jpeg
  Cache-Control: public, max-age=86400

*.webp
  Cache-Control: public, max-age=86400

*.svg
  Cache-Control: public, max-age=86400

# Fonts
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Optional: API / dynamische Inhalte NICHT cachen
/api/*
  Cache-Control: no-store