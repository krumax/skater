# HTML immer frisch laden (explizit, damit der Catch-All die Asset-Regeln nicht überschreibt)
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/app/
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/app/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/landing/
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/landing/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/landing/impressum.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Digital Asset Links - für TWA/Android Play Store
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate

# Landing-CSS & JS (kein Hash im Dateinamen → nie lang cachen)
/landing/css/*
  Cache-Control: public, max-age=0, must-revalidate

/landing/js/*
  Cache-Control: public, max-age=0, must-revalidate

# JS & CSS (versioniert → lange cachen)
*.js
  Cache-Control: public, max-age=31536000, immutable

*.css
  Cache-Control: public, max-age=31536000, immutable

# Bilder (nicht versioniert → moderat cachen)
*.png
  Cache-Control: public, max-age=86400

*.jpg
  Cache-Control: public, max-age=86400

*.jpeg
  Cache-Control: public, max-age=86400

*.webp
  Cache-Control: public, max-age=86400

*.svg
  Cache-Control: public, max-age=86400

# Fonts
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Optional: API / dynamische Inhalte NICHT cachen
/api/*
  Cache-Control: no-store